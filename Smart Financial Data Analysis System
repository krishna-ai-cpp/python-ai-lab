#  GENERATE FINANCIAL FORECAST
# ────────────────────────────────────────────────────────────
print("\n" + "=" * 60)
print("          FINANCIAL FORECAST")
print("=" * 60)

forecast_results = {}

if amount_columns and date_columns:
    dc = date_columns[0]
    ac = amount_columns[0]

    # ── Prepare Forecast Dataset ──────────────────────────────
    monthly_series = df.groupby(df[dc].dt.to_period('M'))[ac].sum().sort_index()
    forecast_values = monthly_series.values.astype(float)
    n = len(forecast_values)
    print(f"  Historical months available : {n}")

    # ── Detect Historical Patterns ────────────────────────────
    if n >= 2:
        avg_monthly   = np.mean(forecast_values)
        trend_slope   = np.polyfit(np.arange(n), forecast_values, 1)[0]
        growth_rate   = np.mean(np.diff(forecast_values) / (forecast_values[:-1] + 1e-9)) * 100
        std_dev       = np.std(forecast_values)
        print(f"  Average Monthly Spending   : ₹{avg_monthly:,.2f}")
        print(f"  Monthly Trend Slope        : ₹{trend_slope:,.2f}")
        print(f"  Avg Monthly Growth Rate    : {growth_rate:.2f}%")
        print(f"  Std Deviation              : ₹{std_dev:,.2f}")

        # ── Apply NumPy Forecast Model (linear extrapolation) ──
        x_hist     = np.arange(n)
        coeffs     = np.polyfit(x_hist, forecast_values, 1)
        poly_model = np.poly1d(coeffs)

        def forecast_month(m):
            return float(poly_model(n + m - 1))

        # ── Predict 1 / 3 / 6 / 12 Months ────────────────────
        pred_1m  = forecast_month(1)
        pred_3m  = sum(forecast_month(i) for i in range(1, 4))
        pred_6m  = sum(forecast_month(i) for i in range(1, 7))
        pred_12m = sum(forecast_month(i) for i in range(1, 13))

        forecast_results = {
            '1  Month' : pred_1m,
            '3  Months': pred_3m,
            '6  Months': pred_6m,
            '12 Months': pred_12m,
        }

        print("\n  FORECAST RESULTS")
        print("  " + "-" * 40)
        for period, value in forecast_results.items():
            print(f"  Predicted Spending ({period}) : ₹{value:,.2f}")

        # ── Calculate Forecast Confidence ─────────────────────
        cv_conf = (std_dev / avg_monthly * 100) if avg_monthly != 0 else 100
        if cv_conf < 20:
            confidence = "High"
        elif cv_conf < 50:
            confidence = "Moderate"
        else:
            confidence = "Low"
        print(f"\n  Forecast Confidence : {confidence} (CV = {cv_conf:.1f}%)")

        # ── Generate Forecast Graph ────────────────────────────
        future_x      = np.arange(n, n + 12)
        future_vals   = [forecast_month(i) for i in range(1, 13)]
        last_date     = monthly_series.index[-1]
        future_labels = [(last_date + i).strftime('%b %Y') for i in range(1, 13)]

        plt.figure(figsize=(12, 5))
        plt.plot(range(n), forecast_values, color='steelblue', lw=2,
                 marker='o', markersize=4, label='Historical')
        plt.plot(range(n - 1, n + 12), [forecast_values[-1]] + future_vals,
                 color='tomato', lw=2, linestyle='--', marker='s',
                 markersize=4, label='Forecast')
        plt.axvline(x=n - 1, color='gray', linestyle=':', lw=1.5, label='Forecast Start')
        all_labels = [str(p) for p in monthly_series.index] + future_labels
        plt.xticks(range(n + 12), all_labels, rotation=45, ha='right', fontsize=8)
        plt.title("Financial Forecast — Next 12 Months")
        plt.xlabel("Month")
        plt.ylabel("Amount (₹)")
        plt.legend()
        plt.grid(True, alpha=0.3)
        plt.tight_layout()
        plt.savefig("forecast_graph.png", dpi=150, bbox_inches='tight')
        graphs_generated += 1
        plt.show()
        print("  Forecast graph generated.")
    else:
        print("  Not enough historical data for forecasting (need at least 2 months).")
else:
    print("  Date or amount columns not detected — skipping forecast.")

