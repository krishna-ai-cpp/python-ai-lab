def tsum(col):
    valid = [c for c in col if c in df.columns]
    if not valid:
        return 0
    return df[valid].select_dtypes(include='number').sum().sum()
def tmean(col):
    valid = [c for c in col if c in df.columns]
    if not valid:
        return 0
    return df[valid].select_dtypes(include='number').mean().mean()
def tmax(col):
    valid = [c for c in col if c in df.columns]
    if not valid:
        return 0
    return df[valid].select_dtypes(include='number').max().max()
def tmin(col):
    valid = [c for c in col if c in df.columns]
    if not valid:
        return 0
    return df[valid].select_dtypes(include='number').min().min()
